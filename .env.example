# =============================================================================
# POLYMARKET HFT ARBITRAGE BOT — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in all values before starting the bot.
# NEVER commit your .env file to version control.

# =============================================================================
# WALLET & KEYS
# =============================================================================
# The private key of the wallet that will sign and send all transactions.
# This wallet must hold MATIC (for gas) and USDC.e (collateral) on Polygon.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# The Polymarket API credentials tied to your trading wallet (L1 signer).
# Obtain from: https://docs.polymarket.com/#authentication
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_API_SECRET=your_polymarket_api_secret
POLYMARKET_API_PASSPHRASE=your_polymarket_api_passphrase

# =============================================================================
# RPC — POLYGON MAINNET (USE WEBSOCKET FOR LOW LATENCY)
# =============================================================================
# Alchemy WebSocket URL (preferred for low latency on Polygon PoS)
# Get from: https://dashboard.alchemy.com
POLYGON_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Alchemy HTTPS fallback (used only for one-off calls during startup)
POLYGON_HTTPS_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional: Secondary RPC for failover (e.g. QuickNode or Ankr)
POLYGON_WSS_FALLBACK=wss://divine-example.matic.quiknode.pro/YOUR_QN_KEY/

# =============================================================================
# WEATHER DATA FEED
# =============================================================================
# CheckWX API key — aviation weather WebSocket + REST
# Sign up at: https://www.checkwx.com/dashboard
CHECKWX_API_KEY=your_checkwx_api_key

# Comma-separated ICAO station codes to monitor (e.g. KNYC = Central Park NYC)
METAR_STATIONS=KNYC,KLGA,KJFK

# Polling interval in milliseconds for METAR refresh (minimum 30000 = 30s).
# Many METAR stations update every 20–60 minutes, but we poll aggressively
# so we catch any intra-hour special observations (SPECI).
METAR_POLL_INTERVAL_MS=15000

# Temperature unit: C (Celsius) or F (Fahrenheit)
TEMPERATURE_UNIT=F

# =============================================================================
# POLYMARKET MARKET CONFIGURATION
# =============================================================================
# The unique condition ID of the target Polymarket weather market.
# Find it in the market URL or via the Gamma API.
CONDITION_ID=0xYOUR_MARKET_CONDITION_ID

# Token IDs for YES and NO outcomes (from Gamma API market details).
YES_TOKEN_ID=your_yes_token_id
NO_TOKEN_ID=your_no_token_id

# The temperature threshold the market resolves on (degrees, same unit as above)
TEMP_THRESHOLD=95

# =============================================================================
# TRADING PARAMETERS
# =============================================================================
# Maximum USDC.e to deploy per arbitrage cycle (6 decimal places, e.g. 500 USDC)
MAX_POSITION_USDC=500

# Minimum edge (EV advantage) required to fire a trade, expressed as a decimal.
# 0.03 = only trade if we have at least 3 cents edge per dollar.
MIN_EV_EDGE=0.03

# Slippage ceiling: maximum fraction of the order book we will consume.
# 0.20 = stop if our order would eat more than 20% of available liquidity.
MAX_SLIPPAGE_FRACTION=0.20

# Number of price tiers to read from the CLOB order book.
ORDER_BOOK_DEPTH=10

# Maximum gas limit for CTF split transaction
GAS_LIMIT_SPLIT=250000

# Maximum gas limit for CLOB order placement
GAS_LIMIT_ORDER=200000

# =============================================================================
# EIP-1559 GAS STRATEGY
# =============================================================================
# Multiplier applied to the network baseFee to set maxFeePerGas.
# 1.5 = pay up to 1.5× the current base fee.
BASE_FEE_MULTIPLIER=1.5

# Extra tip (GWEI) added on top of the baseFee for priority inclusion.
# For Polygon, 30–100 GWEI is aggressive. Increase during congestion.
PRIORITY_FEE_GWEI=50

# =============================================================================
# SMART CONTRACT ADDRESSES (Polygon Mainnet — do not change unless re-deploying)
# =============================================================================
CTF_CONTRACT=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
CTF_EXCHANGE=0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E
NEG_RISK_EXCHANGE=0xC5d563A36AE78145C45a50134d48A1215220f80a
USDC_CONTRACT=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# =============================================================================
# POLYMARKET API ENDPOINTS
# =============================================================================
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://clob.polymarket.com/ws

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_DIR=./logs
